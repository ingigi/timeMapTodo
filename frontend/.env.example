VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Use the same workspace ID in the Windows app and iPhone app to share one task board.
VITE_FIREBASE_WORKSPACE_ID=default

# Existing local/legacy Firebase data will only be claimed by this account.
VITE_FIREBASE_LEGACY_OWNER_EMAIL=

# Required for packaged Electron Google sign-in through the system browser.
# Create this in Google Cloud Console as OAuth client type: Desktop app.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
